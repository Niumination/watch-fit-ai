# ---- identitas & auth ----
DOMAIN=voice.domainmu.com
GATEWAY_SECRET=ganti-dengan-random-64-hex
DEFAULT_AGENT=opencode

# ---- agent ----
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=
OPENCODE_MODEL=
DEEPSEEK_HARNESS_URL=http://127.0.0.1:7001/ask
DEEPSEEK_HARNESS_TOKEN=
OPENMAUSBOT_URL=http://127.0.0.1:7002/ask
OPENMAUSBOT_TOKEN=

# ---- VAD (Voice Activity Detection) ----
VAD_BACKEND=energy                 # energy (ringan, adaptif) | silero (ONNX)
SILERO_ONNX_PATH=models/silero_vad.onnx

# ---- ASR (Speech-to-Text) ----
ASR_BACKEND=groq                   # groq (~150ms) | openai | gemini | faster-whisper | stub
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_ASR_MODEL=whisper-1
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ---- TTS (Text-to-Speech) ----
TTS_BACKEND=tone                   # tone (uji tanpa API) | openai | piper | gemini | edge | null
OPENAI_TTS_VOICE=alloy             # alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_MODEL=tts-1
PIPER_MODEL=/models/id_ID-voice.onnx
EDGE_VOICE=id-ID-ArdiNeural
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VOICE_MAX_SENTENCES=4
