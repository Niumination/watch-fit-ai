{
  "app": {
    "bundleName": "id.agentcall.watch",
    "vendor": "personal",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "apiVersion": {
      "compatible": 5,
      "target": 6
    }
  },
  "deviceConfig": {
    "default": {
      "permissions": [
        "ohos.permission.INTERNET"
      ]
    }
  },
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true
    },
    "abilities": [
      {
        "name": "default",
        "icon": "$media:icon",
        "label": "Agent",
        "launchType": "singleton",
        "type": "page",
        "visible": true,
        "skills": [
          {
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "js": [
      {
        "name": "default",
        "pages": [
          "pages/index/index"
        ],
        "window": {
          "designWidth": 480
        }
      }
    ],
    "metaData": {
      "customizeData": [
        {
          "name": "supportLists",
          "value": "id.agentcall:GANTI_DENGAN_FINGERPRINT_APP_ANDROID",
          "extra": ""
        }
      ]
    }
  }
}
